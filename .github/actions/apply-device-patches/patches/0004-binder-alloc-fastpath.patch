From: Antigravity <antigravity@google.com>
Date: Wed, 14 Oct 2026 00:00:00 +0000
Subject: [PATCH] android: binder_alloc: optimize buffer lookup and free-space search paths

Optimize binder_alloc_new_buf_locked by annotating async buffer exhaustion
with unlikely() and favoring forward search in the free_buffers rbtree.
No changes to struct binder_alloc layout in binder_alloc.h (100% KMI/ABI safe).

Signed-off-by: Antigravity <antigravity@google.com>
---
 drivers/android/binder_alloc.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

--- a/drivers/android/binder_alloc.c
+++ b/drivers/android/binder_alloc.c
@@ -460,7 +460,7 @@ static struct binder_buffer *binder_alloc_new_buf_locked(
 		return ERR_PTR(-ESRCH);
 	}
 
-	if (is_async && alloc->free_async_space < size) {
+	if (unlikely(is_async && alloc->free_async_space < size)) {
 		binder_alloc_debug(BINDER_DEBUG_BUFFER_ALLOC,
 			     "%d: binder_alloc_buf size %zd failed, no async space left\n",
 			      alloc->pid, size);
@@ -475,7 +475,7 @@ static struct binder_buffer *binder_alloc_new_buf_locked(
 		if (size < buffer_size) {
 			best_fit = n;
 			n = n->rb_left;
-		} else if (size > buffer_size)
+		} else if (likely(size > buffer_size))
 			n = n->rb_right;
 		else {
 			best_fit = n;
-- 
2.43.0
