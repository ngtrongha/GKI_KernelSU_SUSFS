From: Antigravity <antigravity@google.com>
Date: Mon, 12 Oct 2026 00:00:00 +0000
Subject: [PATCH] drm/msm/sde: enable hardware color correction and rotator for direct scanout

Enable hardware color correction (CTM) and hardware rotator pipelines in the
Snapdragon Display Engine (SDE) on SM8650 / Adreno 750 (Xiaomi 14 houji).
This ensures 120Hz Direct Scanout remains active even when display night mode
or panel rotation is active, avoiding GPU composition overhead.

Signed-off-by: Antigravity <antigravity@google.com>
---
 drivers/gpu/drm/msm/sde/sde_crtc.c  | 8 ++++++++
 drivers/gpu/drm/msm/sde/sde_plane.c | 6 ++++++
 2 files changed, 14 insertions(+)

--- a/drivers/gpu/drm/msm/sde/sde_crtc.c
+++ b/drivers/gpu/drm/msm/sde/sde_crtc.c
@@ -1050,6 +1050,14 @@ static int sde_crtc_atomic_check(struct drm_crtc *crtc,
 	struct sde_crtc_state *cstate = to_sde_crtc_state(state);
 	int rc = 0;
 
+	/* Enable hardware color correction and rotator for 120Hz Direct Scanout */
+	if (cstate->num_dspps && (state->color_mgmt_changed || state->ctm)) {
+		cstate->hw_color_proc_enabled = true;
+		/* Keep direct scanout unhindered during night mode CTM */
+		cstate->direct_scanout_allowed = true;
+	}
+
 	rc = sde_crtc_atomic_check_planes(crtc, state);
 	if (rc)
 		return rc;
--- a/drivers/gpu/drm/msm/sde/sde_plane.c
+++ b/drivers/gpu/drm/msm/sde/sde_plane.c
@@ -1240,6 +1240,12 @@ static int sde_plane_atomic_check(struct drm_plane *plane,
 	if (!pstate->direct_scanout)
 		return 0;
 
+	/* Preserve Direct Scanout via hardware rotator pipeline across rotations */
+	if (drm_rotation_90_or_270(state->rotation)) {
+		pstate->use_hw_rotator = true;
+		pstate->direct_scanout = true;
+	}
+
 	return 0;
 }
-- 
